{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "nodenv", "custom.regex"],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Dependabot is the primary dependency updater.",
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Update docker:// action references unsupported by Dependabot.",
      "matchDatasources": ["docker"],
      "matchDepTypes": ["docker"],
      "enabled": true
    },
    {
      "description": "Update the shared Node.js runtime from the root version file.",
      "matchManagers": ["nodenv"],
      "matchFileNames": [".node-version"],
      "enabled": true,
      "automerge": false
    },
    {
      "description": "Update the pnpm fallback used when projects do not declare packageManager.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["pnpm"],
      "enabled": true,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^actions/setup-node/action\\.yml$/"],
      "matchStrings": [
        "DEFAULT_PNPM_VERSION: \"(?<currentValue>[^\"\\r\\n]+)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "npm"
    }
  ]
}
