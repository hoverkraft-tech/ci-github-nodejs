{
  "name": "continuous-integration-contract-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS_DIR/junit.xml\"",
    "test:vitest": "vitest run --config fixtures/vitest.config.mjs"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "yaml": "2.9.1",
    "vitest": "5.1.1",
    "@vitest/coverage-v8": "5.1.1"
  }
}
