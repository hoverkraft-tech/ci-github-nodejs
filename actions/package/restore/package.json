{
  "name": "package-restore-tests",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:ci": "coverage_flag=--experimental-test-coverage; if [ \"${CI_TEST_COVERAGE:-true}\" = false ]; then coverage_flag=--no-experimental-test-coverage; fi; node \"$coverage_flag\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"${CI_REPORTS_DIR:-coverage}/junit.xml\" --test-reporter=lcov --test-reporter-destination=\"${CI_REPORTS_DIR:-coverage}/coverage/lcov.info\" --test",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync((process.env.CI_REPORTS_DIR || 'coverage') + '/coverage', {recursive:true})\""
  },
  "devDependencies": {
    "@actions/exec": "^3.0.0"
  }
}
